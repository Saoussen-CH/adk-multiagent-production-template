VITE_API_URL=http://localhost:8000
# Stands in for the store identifier a real embed-script mechanism would
# supply per-widget (out of scope for this plan) — see ChatRequest.tenant_id.
# Must be a tenant that actually exists in the `tenants` collection: the
# backend rejects an unknown tenant_id with 404 rather than falling back to
# a default. "acme-electronics" is the one seeded by
# customer_support_mas/database/fixtures.py.
VITE_TENANT_ID=acme-electronics
