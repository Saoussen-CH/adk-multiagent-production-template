%% Multi-Agent Customer Support System - System Overview
%% Google Cloud Platform Style

graph TB
    subgraph "User Layer"
        User[👤 User]
    end

    subgraph "Cloud Run Backend"
        Backend[⚙️ FastAPI Proxy<br/>Retry/backoff + circuit breaker<br/>Model Armor prompt/response screening]
    end

    subgraph "Vertex AI Agent Engine Runtime (Agent Identity)"
        subgraph "Root Coordinator"
            RootAgent[🤖 Root Agent<br/>Model: Gemini 3.5 Flash<br/>Error Handling: Always Respond<br/>Callback: auto_save_to_memory]
        end

        subgraph "Specialist Agents"
            ProductAgent[🛍️ Product Agent<br/>Model: Gemini 3.5 Flash<br/>+ PreloadMemoryTool<br/>+ get_product_info default<br/>Callback: auto_save_to_memory]
            OrderAgent[📦 Order Agent<br/>Model: Gemini 3.5 Flash<br/>+ PreloadMemoryTool<br/>+ track_shipment — MCP, env-gated<br/>Callback: auto_save_to_memory]
            BillingAgent[💳 Billing Agent<br/>Model: Gemini 3.5 Flash<br/>+ PreloadMemoryTool<br/>Note: Refunds via workflow only<br/>Callback: auto_save_to_memory]
        end

        subgraph "Workflow Patterns"
            RefundWorkflow[🔄 Sequential Workflow<br/>Model: Gemini 3.5 Flash<br/>3-Step: validate → eligibility → stage<br/>Only ever STAGES — never executes]
        end

        subgraph "Memory Management"
            Tracking[📊 Memory Callbacks<br/>auto_save_to_memory: Save session<br/>Creates VertexAiMemoryBankService<br/>Automatic extraction & persistence]
        end
    end

    subgraph "Governed External Egress"
        Gateway[🔒 Agent Gateway<br/>Agent-to-Anywhere egress<br/>IAP tool-level authorization<br/>60 internal API hostnames registered]
        FedExMCP[FedEx Tracking MCP<br/>Cloud Run, invoker SA impersonation]
    end

    subgraph "Human-in-the-Loop Approval"
        Approver[🧑‍💼 Approver Admin UI + API<br/>dual control: requester ≠ approver]
        RefundRequests[(refund_requests<br/>PENDING_APPROVAL staging)]
        RefundsDB[(refunds<br/>written only after approval)]
    end

    subgraph "Memory Bank"
        MemoryService[💾 Memory Bank Service<br/>Generation: Gemini 2.5 Flash<br/>Embedding: text-embedding-004]
        MemoryStore[(Memory Store<br/>USER_PREFERENCES)]
    end

    subgraph "Google Cloud Services"
        Firestore[(🔥 Firestore<br/>Products, Orders, Sessions<br/>refund_policy — versioned config<br/>Vector Search)]
        CloudStorage[☁️ Cloud Storage<br/>Agent Staging]
    end

    User -->|Query| Backend
    Backend -->|Query| RootAgent
    RootAgent -->|Route| ProductAgent
    RootAgent -->|Route| OrderAgent
    RootAgent -->|Route| BillingAgent
    RootAgent -->|Route + reason_code| RefundWorkflow

    ProductAgent -->|RAG Search| Firestore
    OrderAgent -->|Fetch Orders| Firestore
    OrderAgent -.->|if MCP_FEDEX_URL set| Gateway
    Gateway --> FedExMCP
    BillingAgent -->|Fetch Invoices| Firestore

    RefundWorkflow -->|Stage PENDING_APPROVAL| RefundRequests
    RefundRequests --> Approver
    Approver -->|Approve, dual-control checked| RefundsDB

    RootAgent -.->|Save Session| MemoryService
    ProductAgent -.->|Save Session| MemoryService
    OrderAgent -.->|Save Session| MemoryService
    BillingAgent -.->|Save Session| MemoryService

    MemoryService -->|Store| MemoryStore
    ProductAgent -->|Load Memories| MemoryStore

